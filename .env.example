# ValueCompass environment variables. Names only - never put a value in this file. Copy to .env (ignored by git) and fill in.

# Supabase production (the runner, service role)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase test project
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=
# Direct Postgres connection string of PRODUCTION; turns on the weekly pg_dump backup (needs pg_dump on this PC). Leave empty to keep the backup off.
SUPABASE_PROD_DB_URL=

# Gemini (loading, the runner)
GEMINI_API_KEY=
GEMINI_MODEL=
# Search tools
TAVILY_API_KEY=
SEC_USER_AGENT=
# Translation (Azure)
TRANSLATION_PROVIDER=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Edge Function secrets (set with `supabase secrets set`, NOT in the screen): SUPABASE_SERVICE_ROLE_KEY is provided by Supabase itself
# GEMINI_SEARCH_KEY=        smart search, its own Google project; without it the regular search always answers
# GEMINI_SEARCH_MODEL=
# RESEND_API_KEY=           email to the admin on a new support request
# EMAIL_FROM=
# SEC_USER_AGENT=           also needed by request-company
# SITE_URL=                 where the invitation link lands
# ADMIN_EMAIL=              fallback; the value in app_settings wins

# Screen (K7): only the publishable key may be in the screen bundle
# SUPABASE_PUBLISHABLE_KEY=
